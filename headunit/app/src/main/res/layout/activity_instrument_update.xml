<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_root">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="OpenBYDDisplay" android:textSize="24sp" android:textColor="@color/text_primary" android:textStyle="bold" />
        <TextView android:id="@+id/projectRiskNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp" android:paddingBottom="16dp" android:text="@string/project_risk_notice" android:textSize="16sp" android:textColor="@color/warn_amber" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="12dp" android:text="定制开发请联系作者，定制类仪表固件需要收费。" android:textSize="14sp" android:textColor="@color/text_secondary" />
        <Button android:id="@+id/customSupport" android:layout_width="match_parent" android:layout_height="52dp" android:text="联系作者 · 定制与支持" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="连接自研仪表服务，无登录、VIP或商业许可证。" android:textSize="16sp" android:textColor="@color/text_secondary" />
        <EditText android:id="@+id/updateHost" android:layout_width="match_parent" android:layout_height="56dp" android:inputType="textUri" android:singleLine="true" android:hint="仪表地址" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="16dp" android:text="投屏（自研协议）" android:textSize="18sp" android:textColor="@color/text_primary" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="8dp" android:text="支持屏幕镜像、地图独立副屏、高德飞屏版副地图和动态标定图。需要匹配的自研仪表接收服务。「填满标定区域」不是隐藏原厂车速/电量的全屏；唐版那种全屏需仪表 HMI 页面与遮罩，当前未接入。尚待实车测试。" android:textSize="14sp" android:textColor="@color/text_secondary" />
        <Switch android:id="@+id/castFullWidth" android:layout_width="match_parent" android:layout_height="48dp" android:text="填满仪表标定区域（不是隐藏原厂 HMI；关闭则用小窗口）" android:checked="true" android:textColor="@color/text_primary" />
        <Switch android:id="@+id/castSoftEdge" android:layout_width="match_parent" android:layout_height="48dp" android:text="柔边（跟随车机实际深浅模式）" android:checked="true" android:textColor="@color/text_primary" />
        <Switch android:id="@+id/castLyrics" android:layout_width="match_parent" android:layout_height="48dp" android:text="显示当前音乐及本地 LRC 歌词" android:checked="false" android:textColor="@color/text_primary" />
        <Switch android:id="@+id/castNav" android:layout_width="match_parent" android:layout_height="48dp" android:text="显示高德导航文字（需地图广播数据）" android:checked="false" android:textColor="@color/text_primary" />
        <Switch android:id="@+id/castAutoReconnect" android:layout_width="match_parent" android:layout_height="48dp" android:text="断线后重试连接（最多连续 3 次）" android:checked="true" android:textColor="@color/text_primary" />
        <Button android:id="@+id/castOptions" android:layout_width="match_parent" android:layout_height="52dp" android:text="画面来源、布局与画质设置" />
        <Button android:id="@+id/castMediaAccess" android:layout_width="match_parent" android:layout_height="52dp" android:text="允许读取当前音乐（通知使用权）" />
        <Button android:id="@+id/castLrc" android:layout_width="match_parent" android:layout_height="52dp" android:text="导入本地歌词（歌曲标题.lrc）" />
        <Button android:id="@+id/castMapAdb" android:layout_width="match_parent" android:layout_height="52dp" android:text="复制地图副屏 ADB 启动命令" />
        <Button android:id="@+id/castStart" android:layout_width="match_parent" android:layout_height="52dp" android:text="开始投屏" />
        <Button android:id="@+id/castStop" android:layout_width="match_parent" android:layout_height="52dp" android:text="停止投屏" />
        <Button android:id="@+id/castProbe" android:layout_width="match_parent" android:layout_height="52dp" android:text="检测自研视频服务" />
        <Button android:id="@+id/castRecovery" android:layout_width="match_parent" android:layout_height="52dp" android:text="核对投屏中断后的恢复状态" android:visibility="gone" />
        <TextView android:id="@+id/castStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="16dp" android:textSize="14sp" android:textColor="@color/text_primary" android:textIsSelectable="true" />

        <Button android:id="@+id/ambientOpen" android:layout_width="match_parent" android:layout_height="52dp" android:text="氛围灯 · 动态多色与音乐律动" />
        <Button android:id="@+id/vehicleOpen" android:layout_width="match_parent" android:layout_height="52dp" android:text="车机接口 · USB 与诊断" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="仪表更新" android:textSize="18sp" android:textColor="@color/text_primary" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:paddingBottom="16dp" android:text="自研仪表服务支持免 U 盘增量升级，需先安装匹配的基础服务。宋、唐更新包分别使用。先停止投屏，核对车型及仪表硬件；安装期间保持供电与连接。上传后需手动安装，试启动验证通过才算完成。" android:textSize="16sp" android:textColor="@color/text_secondary" />
        <Button android:id="@+id/updateInfo" android:layout_width="match_parent" android:layout_height="52dp" android:text="检查仪表更新能力" />
        <Button android:id="@+id/updateGitHub" android:layout_width="match_parent" android:layout_height="52dp" android:text="GitHub 发布与下载" />
        <Switch android:id="@+id/startupEnabled" android:layout_width="match_parent" android:layout_height="56dp" android:text="开机自动打开 App" android:checked="false" android:textColor="@color/text_primary" />
        <TextView android:id="@+id/startupStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="14sp" />
        <Button android:id="@+id/startupAdb" android:layout_width="match_parent" android:layout_height="52dp" android:text="ADB 辅助配置" />
        <Button android:id="@+id/updatePick" android:layout_width="match_parent" android:layout_height="52dp" android:text="选择并检查更新包（OBG / ZIP / FUP）" />
        <Button android:id="@+id/updateUpload" android:layout_width="match_parent" android:layout_height="52dp" android:text="上传到仪表并校验" android:enabled="false" />
        <Button android:id="@+id/updateRefresh" android:layout_width="match_parent" android:layout_height="52dp" android:text="刷新本次任务状态" android:enabled="false" />
        <CheckBox android:id="@+id/updateParked" android:layout_width="match_parent" android:layout_height="56dp" android:text="我已停车，已核对当前车型及仪表硬件" android:checked="false" android:textColor="@color/text_primary" />
        <Button android:id="@+id/updateApply" android:layout_width="match_parent" android:layout_height="52dp" android:text="安装到仪表" android:enabled="false" />
        <Button android:id="@+id/updateCancel" android:layout_width="match_parent" android:layout_height="52dp" android:text="停止传输 / 清除暂存包" android:enabled="false" />
        <TextView android:id="@+id/updateStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="20dp" android:textSize="16sp" android:textColor="@color/text_primary" android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
